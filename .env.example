# Copy values into your shell/environment or hosting dashboard.
# ATLAS does not automatically load .env files. Never commit real credentials.
# Omit DATABASE_URL for local SQLite under var/.
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@NEON_HOST/DB?sslmode=verify-full
APP_ORIGIN=http://127.0.0.1:5173
ATLAS_USERNAME=
# Generate privately: PYTHONPATH=backend .venv/bin/python -m atlas.auth
ATLAS_PASSWORD_HASH=
# Cloud only: ATLAS_ENV=production (requires HTTPS and PostgreSQL)
